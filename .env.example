# Code Agent Environment Configuration Template
# ============================================
# 
# Copy this file to .env and fill in your actual values.
# Important: NEVER commit .env to version control!
# 
# The .env file is already in .gitignore for your safety.

# LLM Configuration
# Provider: deepseek, openai, or other OpenAI-compatible API
LLM_PROVIDER=deepseek

# API Key from your LLM provider
# Get your DeepSeek API Key from: https://platform.deepseek.com/api_keys
# Get your OpenAI API Key from: https://platform.openai.com/api-keys
LLM_API_KEY=sk-your-actual-api-key-here

# LLM Model to use for code generation
# Common options: deepseek-chat, gpt-4, gpt-3.5-turbo
LLM_MODEL=deepseek-chat

# API Base URL (usually provided by your LLM provider)
# DeepSeek: https://api.deepseek.com
# OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com

# Agent-specific Models (optional - will default to LLM_MODEL if not set)
# Leave as-is or specify different models for different agents
PLANNER_MODEL=deepseek-chat
CODER_MODEL=deepseek-chat
REVIEWER_MODEL=deepseek-chat

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Workspace Directory
# Default: ./workspace
# WORKSPACE_DIR=./workspace

# Optional: Conversation History Directory
# Default: ./.conversation_history
# CONVERSATION_HISTORY_DIR=./.conversation_history
